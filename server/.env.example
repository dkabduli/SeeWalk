# Copy to server/.env and fill in. Never commit .env.
# Free tier for now: each teammate creates their OWN key at https://aistudio.google.com/api-keys
# so we don't share one rate limit. Billing gets enabled on the demo key before the field walk.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_QUESTION_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=minimal

ELEVENLABS_API_KEY=
# River: one multilingual voice for EN + FR (see generate_clips.py --list-voices)
ELEVENLABS_VOICE_ID=SAz9YHcvj6GT2YYXdXww
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Tiger Data connection string (needed later for the hazard map)
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:5173
