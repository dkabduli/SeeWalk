# Copy to server/.env and fill in. Never commit .env.
# Free tier for now: each teammate creates their OWN key at https://aistudio.google.com/api-keys
# so we don't share one rate limit. Billing gets enabled on the demo key before the field walk.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

ELEVENLABS_API_KEY=
# one multilingual voice for EN + FR (pick with generate_clips.py --list-voices)
ELEVENLABS_VOICE_ID=

# Tiger Data connection string (needed later for the hazard map)
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:5173
